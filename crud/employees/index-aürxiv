// Edit funksiyası
function editEmployee(id) {
    // AJAX ilə məlumatları gətir
    fetch(`../../api/get_employee.php?id=${id}`)
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                const employee = data.data;
                
                // Modal inputları doldur
                document.getElementById('edit_id').value = employee.id;
                document.getElementById('edit_ad').value = employee.ad;
                document.getElementById('edit_soyad').value = employee.soyad;
                document.getElementById('edit_user_id').value = employee.user_id || '';
                document.getElementById('edit_sector_id').value = employee.sector_id || '';
                document.getElementById('edit_position_id').value = employee.position_id || '';
                
                // Modalı aç
                const editModal = new bootstrap.Modal(document.getElementById('editEmployeeModal'));
                editModal.show();
            } else {
                alert('Məlumat gətirilərkən xəta baş verdi: ' + (data.message || 'Bilinməyən xəta'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Xəta baş verdi: ' + error.message);
        });
}

// Confirm funksiyası
function confirmDelete(message) {
    return confirm(message || 'Bu əməliyyatı təsdiqləyirsiniz?');
}
</script>

