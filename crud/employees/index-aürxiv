// 3. Sil (GET)
if (isset($_GET['delete_id']) && is_numeric($_GET['delete_id'])) {
    $id = intval($_GET['delete_id']);
    
    try {
        // Əvvəlcə məlumatı götürək log üçün
        $sql_select = "SELECT ad, soyad FROM employees WHERE id = ?";
        $stmt_select = $conn->prepare($sql_select);
        $stmt_select->bind_param("i", $id);
        $stmt_select->execute();
        $result = $stmt_select->get_result();
        $deleted_data = $result->fetch_assoc();
        $stmt_select->close();
        
        // Silmə əməliyyatı
        $sql = "DELETE FROM employees WHERE id = ?";
        $stmt = $conn->prepare($sql);
        $stmt->bind_param("i", $id);
        
        if ($stmt->execute()) {
            $message = "İşçi uğurla silindi!";
            
            // Log yaz
            $logMessage = date('Y-m-d H:i:s') . " - " . $_SESSION['user_id'] . " - DELETE_EMPLOYEE - ID: $id, Name: " . ($deleted_data['ad'] ?? '') . " " . ($deleted_data['soyad'] ?? '') . PHP_EOL;
            $logFile = __DIR__ . '/../../logs/log_' . date('Y_m_d') . '.txt';
            file_put_contents($logFile, $logMessage, FILE_APPEND);
            
            $_SESSION['success_message'] = $message;
            header("Location: index.php");
            exit();
        } else {
            $error = "Xəta baş verdi: " . $stmt->error;
        }
        
        $stmt->close();
    } catch (Exception $e) {
        $error = "Sistem xətası: " . $e->getMessage();
    }
}

// Session mesajlarını yoxla
if (isset($_SESSION['success_message'])) {
    $message = $_SESSION['success_message'];
    unset($_SESSION['success_message']);
}

// İşçilərin siyahısını götür
$employees = [];
$sectors = [];
$positions = [];
$users = [];

try {
    // İşçiləri götür
    $sql = "SELECT e.*, 
                   s.name as sector_name,
                   p.name as position_name,
                   u.username as user_username
            FROM employees e
            LEFT JOIN sectors s ON e.sector_id = s.id
            LEFT JOIN positions p ON e.position_id = p.id
            LEFT JOIN users u ON e.user_id = u.id
            ORDER BY e.ad, e.soyad";
    
    $result = $conn->query($sql);
    
    if ($result) {
        if ($result->num_rows > 0) {
            $employees = $result->fetch_all(MYSQLI_ASSOC);
        }
    } else {
        $error = "SQL sorğusunda xəta: " . $conn->error;
        error_log("Employees SQL Error: " . $conn->error);
    }
    
    // Sektorları götür
    $sql_sectors = "SELECT id, name FROM sectors ORDER BY name";
    $result_sectors = $conn->query($sql_sectors);
    if ($result_sectors) {
        $sectors = $result_sectors->fetch_all(MYSQLI_ASSOC);
    } else {
        error_log("Sectors SQL Error: " . $conn->error);
    }
    
    // Vəzifələri götür
    $sql_positions = "SELECT id, name FROM positions ORDER BY name";
    $result_positions = $conn->query($sql_positions);
    if ($result_positions) {
        $positions = $result_positions->fetch_all(MYSQLI_ASSOC);
    } else {
        error_log("Positions SQL Error: " . $conn->error);
    }
    
    // İstifadəçiləri götür (hələ employee olmayan)
    $sql_users = "SELECT id, username FROM users 
                  WHERE role = 'isci' 
                  AND id NOT IN (SELECT user_id FROM employees WHERE user_id IS NOT NULL)
                  ORDER BY username";
    $result_users = $conn->query($sql_users);
    if ($result_users) {
        $users = $result_users->fetch_all(MYSQLI_ASSOC);
    } else {
        error_log("Users SQL Error: " . $conn->error);
    }
    
} catch (Exception $e) {
    $error = "Məlumat gətirilərkən xəta: " . $e->getMessage();
    error_log("Database Exception: " . $e->getMessage());
}

